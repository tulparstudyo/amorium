APP_NAME="Amorium"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_LOCALE=tr

ACTIVE_THEME=amorium
BACKEND_URI=/admin
CMS_ROUTE_CACHE=true
CMS_ASSET_CACHE=true
LINK_POLICY=detect

DB_CONNECTION=mysql
DB_URL="mysql://USER:PASSWORD@127.0.0.1:3306/DATABASE?engine=InnoDB"

TRANSLATE_ENABLED=false
TRANSLATE_MODEL="gemini-flash-latest"
TRANSLATE_API_KEY=
TRANSLATE_TIMEOUT=120
TRANSLATE_VERIFY_SSL=true
TRANSLATE_BATCH_CHARS=20000
TRANSLATE_GEMINI_API_URL="https://generativelanguage.googleapis.com/v1beta"
TRANSLATE_GEMMA_API_URL=
